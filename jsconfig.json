{
    "compilerOptions": {
        "paths": {
            "*": [
                "./src/*"
            ],
            "@assets/*": [
                "./src/assets/*"
            ],
            "@components/*": [
                "./src/components/*"
            ],
            "@hooks/*": [
                "./src/hooks/*"
            ],
            "@pages/*": [
                "./src/pages/*"
            ],
            "@routes/*": [
                "./src/routes/*"
            ],
            "@services/*": [
                "./src/services/*"
            ],
            "@store/*": [
                "./src/store/*"
            ],
            "@utils/*": [
                "./src/utils/*"
            ]
        }
    }
}
